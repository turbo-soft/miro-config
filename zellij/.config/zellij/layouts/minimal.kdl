layout {
    tab hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zj-status-bar.wasm"
        }
        pane
        floating_panes {
            pane command="bash" {
                args "-c" "$HOME/.config/zellij/scripts/claude-float.sh"
                x "10%"
                y "10%"
                width "80%"
                height "80%"
            }
        }
    }
    new_tab_template hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zj-status-bar.wasm"
        }
        pane
        floating_panes {
            pane command="bash" {
                args "-c" "$HOME/.config/zellij/scripts/claude-float.sh"
                x "10%"
                y "10%"
                width "80%"
                height "80%"
            }
        }
    }
}
